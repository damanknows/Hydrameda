FROM python:3.12-slim-bookworm

# Security & Determinism: Pin explicit tool versions
RUN pip install --no-cache-dir \
    pytest==8.3.4 \
    ruff==0.8.4 \
    mypy==1.14.0 \
    bandit==1.8.0 \
    pydantic==2.10.4

# Create unprivileged non-root user and group (UID:GID 10001:10001)
RUN groupadd -g 10001 sandboxgroup && \
    useradd -m -u 10001 -g 10001 -s /bin/sh sandboxuser

# Security documentation:
# Running as non-root (UID:GID 10001:10001) inside the container prevents in-container
# privilege escalation. However, it does not prove rootless execution of the host Docker
# daemon itself (dockerd). Defense-in-depth requires capability drops (--cap-drop ALL),
# no-new-privileges, network isolation, and read-only root filesystems.
USER 10001:10001
WORKDIR /app

ENTRYPOINT ["sh", "-c"]
