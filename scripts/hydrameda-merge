#!/usr/bin/env bash
# Portable Hydrameda Merge & Worktree Inspection wrapper
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export HYDRAMEDA_ROOT="${HYDRAMEDA_ROOT:-$REPO_ROOT}"
export OBSIDIAN_VAULT_PATH="${OBSIDIAN_VAULT_PATH:-$HOME/ObsidianVault}"

if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    PYTHON_BIN="$REPO_ROOT/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
else
    echo "ERROR: python3 or $REPO_ROOT/.venv/bin/python not found" >&2
    exit 1
fi

exec "$PYTHON_BIN" "$REPO_ROOT/mcp_server/server.py" "$@"
